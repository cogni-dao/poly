{
  "name": "@cogni/node-template-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:app",
    "build:packages": "pnpm -r --if-present --filter \"./packages/**\" --filter \"./graphs\" build && tsc -b packages/*/tsconfig.json packages/langgraph-graphs/tsconfig.build.json packages/doltgres-schema/tsconfig.json graphs/tsconfig.build.json",
    "packages:build": "pnpm build:packages",
    "build:app": "pnpm --filter @cogni/node-template-app build",
    "check:workflow": "node scripts/check-node-ci-workflow.mjs && node scripts/check-node-ci-workflow.test.mjs",
    "conductor:setup": "bash scripts/conductor-worktree-setup.sh",
    "codex:cognition:install": "bash scripts/agent/install-codex-cognition-hook.sh",
    "dev:local": "node scripts/local-runtime.mjs start",
    "dev:local:prepare": "node scripts/local-runtime.mjs prepare",
    "dev:local:health": "node scripts/local-runtime.mjs health",
    "dev:local:down": "node scripts/local-runtime.mjs down",
    "dev:local:test": "node --test scripts/local-runtime.test.mjs",
    "poly:delta-investigation": "tsx scripts/poly-delta-investigation.ts",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:generate:poly:doltgres": "dotenv -e .env.local -- bash -c 'DATABASE_URL=$DOLTGRES_URL_POLY tsx node_modules/drizzle-kit/bin.cjs generate --config=drizzle.doltgres.config.ts'",
    "db:check": "pnpm db:check:drizzle && pnpm db:check:poly:doltgres && pnpm db:check:generate-clean",
    "db:check:drizzle": "DATABASE_URL=postgres://check@localhost:0/check tsx node_modules/drizzle-kit/bin.cjs check --config=drizzle.config.ts",
    "db:check:poly:doltgres": "DATABASE_URL=postgres://check@localhost:0/check tsx node_modules/drizzle-kit/bin.cjs check --config=drizzle.doltgres.config.ts",
    "db:check:generate-clean": "node scripts/db/check-generate-clean.mjs",
    "db:migrate:direct": "tsx node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "db:migrate:poly:doltgres": "dotenv -e .env.local -- bash -c 'DATABASE_URL=$DOLTGRES_URL_POLY tsx node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.doltgres.config.ts'",
    "typecheck": "pnpm --filter @cogni/poly-graphs typecheck && pnpm --filter @cogni/node-template-doltgres-schema typecheck && pnpm --filter @cogni/node-template-app typecheck",
    "test": "pnpm --filter @cogni/poly-graphs test && pnpm --filter @cogni/node-template-app test && pnpm --filter @cogni/poly-market-provider test && pnpm --filter @cogni/poly-ai-tools test",
    "test:ci": "pnpm test",
    "test:component": "pnpm --filter @cogni/node-template-app test:component",
    "check": "pnpm check:workflow && pnpm db:check && pnpm packages:build && pnpm typecheck && pnpm test:ci"
  },
  "pnpm": {
    "overrides": {
      "@assistant-ui/react": "0.12.10",
      "@assistant-ui/react-ai-sdk": "1.3.7",
      "@assistant-ui/react-data-stream": "0.12.4",
      "@assistant-ui/react-markdown": "0.12.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "yaml": "^2.8.3"
  }
}
