# Poly local live-development credentials
#
# Paste only these vendor values. Leave POLYGON_RPC_WSS_URL blank when your
# provider supports WebSockets at the corresponding wss:// endpoint. Everything
# else is generated once under .context/local-runtime and stays outside git.

POLYGON_RPC_URL=
POLYGON_RPC_WSS_URL=

PRIVY_USER_WALLETS_APP_ID=
PRIVY_USER_WALLETS_APP_SECRET=
PRIVY_USER_WALLETS_SIGNING_KEY=
